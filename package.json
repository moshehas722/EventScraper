{
  "name": "event-scraper",
  "version": "0.1.0",
  "description": "Scrapes event/ticketing sites and lists shows (name + price) for a given day.",
  "type": "module",
  "bin": {
    "event-scraper": "src/index.js"
  },
  "scripts": {
