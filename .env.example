# Skip auto-loading events from Vercel Blob and show the local "Fetch events" button.
# Requires the local API server (npm run dev).
VITE_DISABLE_BLOB=true

# API server port (default 3101). Avoid 3001 on Windows — it is often reserved.
PORT=3101

# Gemini API key for the WhatsApp plugin's event extraction (src/whatsapp_plugin/llm.js).
# Without it, incoming WhatsApp messages are still stored, just without extraction.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# The Gemini free tier caps requests/day well below typical WhatsApp message
# volume, so messages are extracted in batches: a batch flushes once it
# reaches this many messages, or this many minutes have passed since the
# oldest queued message, whichever comes first (src/whatsapp_plugin/index.js).
# WHATSAPP_EXTRACTION_BATCH_SIZE=10
# WHATSAPP_EXTRACTION_BATCH_MINUTES=15
